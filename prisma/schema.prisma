// Houzzhills HMS — Complete Database Schema
// PostgreSQL + Prisma ORM
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  CLEAN
  INSPECTED
  MAINTENANCE
  OUT_OF_ORDER
}

enum RoomType {
  STUDIO
  ONE_BEDROOM
  TWO_BEDROOM
}

enum ReservationStatus {
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  WAITLIST
}

enum PaymentMethod {
  CASH
  POS
  BANK_TRANSFER
  PAYSTACK
  FLUTTERWAVE
  OPAY
  PALMPAY
  COMPLIMENTARY
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
  VOID
}

enum UserRole {
  SUPER_ADMIN
  FRONT_DESK
  HOUSEKEEPING_SUPERVISOR
  HOUSEKEEPER
  MAINTENANCE
  STOREKEEPER
  ACCOUNTANT
  NIGHT_AUDITOR
  GUEST
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum BookingSource {
  DIRECT
  WALK_IN
  PHONE
  WHATSAPP
  BOOKING_COM
  AIRBNB
  CORPORATE
  AGENT
}

enum IdType {
  PASSPORT
  NIN
  DRIVERS_LICENSE
  VOTERS_CARD
}

// ─── Core Tables ──────────────────────────────────────────────────────────────

model Property {
  id              String   @id @default(cuid())
  name            String
  code            String   @unique
  address         String
  city            String
  country         String   @default("Nigeria")
  phone           String
  email           String
  website         String?
  logoUrl         String?
  primaryColor    String   @default("#c8861a")
  checkInTime     String   @default("14:00")
  checkOutTime    String   @default("12:00")
  vatRate         Decimal  @default(7.5) @db.Decimal(5, 2)
  serviceCharge   Decimal  @default(10.0) @db.Decimal(5, 2)
  currency        String   @default("NGN")
  timezone        String   @default("Africa/Lagos")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rooms           Room[]
  staff           Staff[]

  @@map("properties")
}

model Room {
  id                    String      @id @default(cuid())
  propertyId            String
  property              Property    @relation(fields: [propertyId], references: [id])
  number                String
  name                  String
  type                  RoomType
  floor                 Int
  status                RoomStatus  @default(AVAILABLE)
  baseRate              Decimal     @db.Decimal(12, 2)
  weekendRate           Decimal     @db.Decimal(12, 2)
  weeklyRate            Decimal     @db.Decimal(12, 2)
  monthlyRate           Decimal     @db.Decimal(12, 2)
  maxOccupancy          Int
  amenities             String[]
  photos                String[]
  description           String?
  notes                 String?
  isActive              Boolean     @default(true)
  lastCleaned           DateTime?
  lastInspected         DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  reservations          Reservation[]
  housekeepingTasks     HousekeepingTask[]
  maintenanceTickets    MaintenanceTicket[]
  inventoryAssignments  RoomInventory[]

  @@unique([propertyId, number])
  @@index([propertyId, status])
  @@map("rooms")
}

model Guest {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String
  email           String?
  phone           String
  nationality     String
  idType          IdType
  idNumber        String
  idExpiry        DateTime?
  idPhotoUrl      String?
  company         String?
  designation     String?
  address         String?
  preferences     String?
  isBlacklisted   Boolean   @default(false)
  blacklistReason String?
  loyaltyPoints   Int       @default(0)
  totalStays      Int       @default(0)
  totalSpend      Decimal   @default(0) @db.Decimal(14, 2)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reservations    Reservation[]
  documents       GuestDocument[]

  @@index([phone])
  @@index([email])
  @@index([idNumber])
  @@map("guests")
}

model GuestDocument {
  id          String   @id @default(cuid())
  guestId     String
  guest       Guest    @relation(fields: [guestId], references: [id])
  type        String   // passport, nin, etc.
  fileUrl     String
  uploadedAt  DateTime @default(now())

  @@map("guest_documents")
}

model CorporateAccount {
  id              String        @id @default(cuid())
  name            String
  contactPerson   String
  email           String
  phone           String
  address         String?
  discountRate    Decimal       @default(0) @db.Decimal(5, 2)
  creditLimit     Decimal       @default(0) @db.Decimal(14, 2)
  outstandingBalance Decimal    @default(0) @db.Decimal(14, 2)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())

  reservations    Reservation[]

  @@map("corporate_accounts")
}

model Reservation {
  id                  String            @id @default(cuid())
  confirmationNumber  String            @unique
  guestId             String
  guest               Guest             @relation(fields: [guestId], references: [id])
  roomId              String
  room                Room              @relation(fields: [roomId], references: [id])
  corporateAccountId  String?
  corporateAccount    CorporateAccount? @relation(fields: [corporateAccountId], references: [id])
  groupId             String?
  status              ReservationStatus @default(CONFIRMED)
  source              BookingSource
  checkIn             DateTime
  checkOut            DateTime
  actualCheckIn       DateTime?
  actualCheckOut      DateTime?
  adults              Int               @default(1)
  children            Int               @default(0)
  nights              Int
  ratePerNight        Decimal           @db.Decimal(12, 2)
  totalRoomCharge     Decimal           @db.Decimal(14, 2)
  extrasTotal         Decimal           @default(0) @db.Decimal(14, 2)
  discountAmount      Decimal           @default(0) @db.Decimal(14, 2)
  vatAmount           Decimal           @default(0) @db.Decimal(14, 2)
  serviceCharge       Decimal           @default(0) @db.Decimal(14, 2)
  grandTotal          Decimal           @db.Decimal(14, 2)
  amountPaid          Decimal           @default(0) @db.Decimal(14, 2)
  balance             Decimal           @db.Decimal(14, 2)
  paymentStatus       PaymentStatus     @default(PENDING)
  specialRequests     String?
  internalNotes       String?
  digitalKeyCode      String?
  registrationSigned  Boolean           @default(false)
  createdBy           String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  folioItems          FolioItem[]
  payments            Payment[]

  @@index([guestId])
  @@index([roomId])
  @@index([checkIn, checkOut])
  @@index([status])
  @@index([confirmationNumber])
  @@map("reservations")
}

model FolioItem {
  id              String      @id @default(cuid())
  reservationId   String
  reservation     Reservation @relation(fields: [reservationId], references: [id])
  date            DateTime
  description     String
  category        String      // room, minibar, laundry, restaurant, extra, fee, discount, tax
  quantity        Decimal     @db.Decimal(8, 2)
  unitPrice       Decimal     @db.Decimal(12, 2)
  amount          Decimal     @db.Decimal(14, 2)
  postedBy        String
  isVoided        Boolean     @default(false)
  voidedBy        String?
  voidedAt        DateTime?
  voidReason      String?
  createdAt       DateTime    @default(now())

  @@index([reservationId])
  @@map("folio_items")
}

model Payment {
  id              String        @id @default(cuid())
  reservationId   String
  reservation     Reservation   @relation(fields: [reservationId], references: [id])
  amount          Decimal       @db.Decimal(14, 2)
  method          PaymentMethod
  reference       String?
  gatewayRef      String?
  status          String        @default("success") // success, pending, failed
  receivedBy      String
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([reservationId])
  @@map("payments")
}

// ─── Housekeeping ─────────────────────────────────────────────────────────────

model HousekeepingTask {
  id              String      @id @default(cuid())
  roomId          String
  room            Room        @relation(fields: [roomId], references: [id])
  type            String      // checkout_clean, stayover_clean, deep_clean, inspection, turndown
  status          TaskStatus  @default(PENDING)
  priority        TaskPriority @default(MEDIUM)
  assignedTo      String?
  scheduledFor    DateTime
  startedAt       DateTime?
  completedAt     DateTime?
  beforePhotos    String[]
  afterPhotos     String[]
  notes           String?
  createdBy       String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  checklistItems  HousekeepingChecklist[]

  @@index([roomId, status])
  @@index([assignedTo, status])
  @@map("housekeeping_tasks")
}

model HousekeepingChecklist {
  id        String           @id @default(cuid())
  taskId    String
  task      HousekeepingTask @relation(fields: [taskId], references: [id])
  label     String
  checked   Boolean          @default(false)
  checkedAt DateTime?
  checkedBy String?
  sortOrder Int              @default(0)

  @@map("housekeeping_checklist")
}

// ─── Maintenance ──────────────────────────────────────────────────────────────

model MaintenanceTicket {
  id              String            @id @default(cuid())
  ticketNumber    String            @unique
  roomId          String?
  room            Room?             @relation(fields: [roomId], references: [id])
  location        String
  title           String
  description     String
  status          MaintenanceStatus @default(OPEN)
  priority        TaskPriority      @default(MEDIUM)
  assignedTo      String?
  reportedBy      String
  estimatedCost   Decimal?          @db.Decimal(12, 2)
  actualCost      Decimal?          @db.Decimal(12, 2)
  photos          String[]
  notes           String?
  resolvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, priority])
  @@map("maintenance_tickets")
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model InventoryItem {
  id              String    @id @default(cuid())
  name            String
  sku             String    @unique
  category        String
  unit            String
  currentStock    Decimal   @db.Decimal(10, 2)
  minStock        Decimal   @db.Decimal(10, 2)
  maxStock        Decimal   @db.Decimal(10, 2)
  unitCost        Decimal   @db.Decimal(12, 2)
  location        String    // central_store, floor_1, floor_2, housekeeping
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  lastRestocked   DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  movements       InventoryMovement[]
  roomAssignments RoomInventory[]

  @@index([category, location])
  @@map("inventory_items")
}

model InventoryMovement {
  id          String        @id @default(cuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id])
  type        String        // in, out, adjustment, transfer
  quantity    Decimal       @db.Decimal(10, 2)
  reference   String?       // PO number, room number, etc.
  notes       String?
  performedBy String
  createdAt   DateTime      @default(now())

  @@index([itemId])
  @@map("inventory_movements")
}

model RoomInventory {
  id        String        @id @default(cuid())
  roomId    String
  room      Room          @relation(fields: [roomId], references: [id])
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id])
  quantity  Decimal       @db.Decimal(10, 2)
  updatedAt DateTime      @updatedAt

  @@unique([roomId, itemId])
  @@map("room_inventory")
}

model Supplier {
  id          String          @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String
  address     String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())

  items       InventoryItem[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  poNumber    String    @unique
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  status      String    @default("draft") // draft, sent, received, cancelled
  totalAmount Decimal   @db.Decimal(14, 2)
  notes       String?
  createdBy   String
  createdAt   DateTime  @default(now())
  receivedAt  DateTime?

  @@map("purchase_orders")
}

// ─── Staff ────────────────────────────────────────────────────────────────────

model Staff {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id])
  firstName   String
  lastName    String
  email       String    @unique
  phone       String
  role        UserRole
  department  String
  passwordHash String
  isActive    Boolean   @default(true)
  avatar      String?
  hireDate    DateTime
  shift       String?   // morning, afternoon, night
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions    StaffSession[]
  auditLogs   AuditLog[]

  @@index([propertyId, role])
  @@map("staff")
}

model StaffSession {
  id          String   @id @default(cuid())
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id])
  token       String   @unique
  ipAddress   String?
  userAgent   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([token])
  @@map("staff_sessions")
}

// ─── Audit & Compliance ───────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  staffId     String?
  staff       Staff?   @relation(fields: [staffId], references: [id])
  action      String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, VIEW
  entity      String   // reservation, room, guest, payment, etc.
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([staffId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model NightAudit {
  id                  String   @id @default(cuid())
  auditDate           DateTime @db.Date
  performedBy         String
  occupancyRate       Decimal  @db.Decimal(5, 2)
  occupiedRooms       Int
  totalRooms          Int
  totalRevenue        Decimal  @db.Decimal(14, 2)
  roomRevenue         Decimal  @db.Decimal(14, 2)
  extrasRevenue       Decimal  @db.Decimal(14, 2)
  totalPaymentsReceived Decimal @db.Decimal(14, 2)
  outstandingBalance  Decimal  @db.Decimal(14, 2)
  checkIns            Int
  checkOuts           Int
  noShows             Int
  notes               String?
  completedAt         DateTime @default(now())

  @@unique([auditDate])
  @@map("night_audits")
}

// ─── Lost & Found ─────────────────────────────────────────────────────────────

model LostAndFound {
  id          String    @id @default(cuid())
  itemName    String
  description String?
  foundAt     String    // location
  foundBy     String
  foundDate   DateTime
  guestId     String?
  status      String    @default("in_storage") // in_storage, returned, donated, disposed
  photos      String[]
  notes       String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@map("lost_and_found")
}
